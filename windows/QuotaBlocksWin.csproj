<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>QuotaBlocks</AssemblyName>
    <RootNamespace>QuotaBlocks</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!--
      The provider marks are shared with the macOS app rather than duplicated,
      so the two ports can never drift apart. LogicalName is set explicitly
      because these files live outside the project directory.
    -->
    <EmbeddedResource Include="..\mac\Sources\QuotaBlocks\Resources\chatgpt.svg"
                      LogicalName="QuotaBlocks.chatgpt.svg" />
    <EmbeddedResource Include="..\mac\Sources\QuotaBlocks\Resources\claude.svg"
                      LogicalName="QuotaBlocks.claude.svg" />
  </ItemGroup>

</Project>
